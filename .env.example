# Copy thành .env rồi điền:  cp .env.example .env
# File .env không commit. `npm run build` đọc file này để điền sẵn node Config của workflow.

# --- Điền vào workflow (n8n/local/autopost.json) ---
# Sheet ID: đoạn giữa /d/ và /edit trong URL Google Sheet
N8N_SHEET_ID=
# ID của Facebook Page sẽ đăng bài
FB_PAGE_ID=
# Token để n8n gọi fb-crawler — tự đặt chuỗi ngẫu nhiên (docker compose cũng đọc biến này)
CRAWLER_TOKEN=

# --- Chỉ dùng cho `npm run check:fb` (kiểm tra token) — n8n không đọc ---
# Page Access Token dài hạn (KHÔNG phải User Token); trong n8n token nằm ở credential
FB_PAGE_TOKEN=
# Tuỳ chọn: giúp script kiểm tra được scope + thời hạn token
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0
