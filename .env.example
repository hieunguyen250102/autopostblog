# Copy thành .env rồi điền:  cp .env.example .env
#
# Phần 1 dùng cho `docker compose` (chạy n8n local).
# Phần 2 dùng cho script kiểm tra ở tools/.
# n8n KHÔNG đọc phần 2; token Facebook của n8n nằm trong credential của n8n.

# ---- 1. Docker Compose ----------------------------------------------------
# URL công khai của n8n (Apps Script gọi từ server Google nên localhost không tới).
# Để trống khi mới thử trong máy; điền URL tunnel khi cần nối với Google Sheet.
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
N8N_SECURE_COOKIE=false

# ---- 2. Script kiểm tra token (tools/check-facebook.mjs) -------------------

# Page Access Token dài hạn (KHÔNG phải User Token)
FB_PAGE_TOKEN=
# ID của Facebook Page sẽ đăng bài
FB_PAGE_ID=
# Tuỳ chọn: giúp script kiểm tra được scope + thời hạn token
FB_APP_ID=
FB_APP_SECRET=
FB_GRAPH_VERSION=v21.0
